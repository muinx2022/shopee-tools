<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <!-- Cách ly kho dữ liệu như Shopee.Core.Tests: SuitePaths đọc data-dir.txt cạnh .exe → Root của test trỏ vào bin\...\test-data
       thay vì %AppData%. Test ở đây đều truyền đường dẫn tạm cho Store; đây là lưới an toàn nếu có chỗ lỡ dùng mặc định. -->
  <ItemGroup>
    <None Update="data-dir.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shopee.Core\Shopee.Core.csproj" />
    <ProjectReference Include="..\..\src\Shopee.Upload\Shopee.Upload.csproj" />
  </ItemGroup>

</Project>
