<Application x:Class="Shopee.Workspace.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ws="clr-namespace:Shopee.Workspace.Modules.Workspace"
             xmlns:bs="clr-namespace:Shopee.Workspace.Modules.BigSeller"
             xmlns:acc="clr-namespace:Shopee.Workspace.Modules.Accounts"
             xmlns:ca="clr-namespace:Shopee.Workspace.Modules.CheckAccount"
             xmlns:settings="clr-namespace:Shopee.Workspace.Modules.Settings"
             xmlns:conv="clr-namespace:Shopee.Workspace.Infrastructure">
    <!-- Entry point thật là Program.Main; MainWindow dựng tay trong App.OnStartup. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
                <ResourceDictionary Source="Themes/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ══════════ Converter dùng chung ══════════ -->
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:InverseBoolConverter x:Key="InvBool" />
            <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
            <conv:CountToVisibilityConverter x:Key="CountToVis" />
            <conv:StringToVisibilityConverter x:Key="StringToVis" />
            <conv:WiderThanConverter x:Key="WiderThan" />

            <!-- ══════════ ViewModel-first navigation ══════════ -->
            <DataTemplate DataType="{x:Type bs:BigSellerViewModel}">
                <bs:BigSellerView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type acc:AccountsViewModel}">
                <acc:AccountsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type ws:WorkspaceViewModel}">
                <ws:WorkspaceView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type ca:CheckAccountViewModel}">
                <ca:CheckAccountView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type settings:LocalSettingsViewModel}">
                <settings:LocalSettingsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
