<UserControl x:Class="Shopee.Workspace.Controls.RevealPasswordBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Shopee.Workspace.Behaviors"
             xmlns:c="clr-namespace:Shopee.Workspace.Controls"
             x:Name="Root">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <PasswordBox x:Name="Masked" Grid.Column="0" Padding="5,2" FontSize="11.5"
                     b:PasswordBoxAssist.BindPassword="True"
                     b:PasswordBoxAssist.BoundPassword="{Binding Password, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBox x:Name="Plain" Grid.Column="0" Padding="5,2" FontSize="11.5" Visibility="Collapsed"
                 Text="{Binding Password, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <Button x:Name="Eye" Grid.Column="1" Width="34" Margin="6,0,0,0" Padding="0"
                ToolTip="Hiện mật khẩu" Click="Toggle_Click" Focusable="False">
            <c:PathIcon x:Name="EyeIcon" Data="{StaticResource IconEye}" />
        </Button>
    </Grid>
</UserControl>
