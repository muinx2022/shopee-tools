<UserControl x:Class="Shopee.Workspace.Modules.Workspace.ScrapeMultiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Shopee.Workspace.Controls"
             xmlns:b="clr-namespace:Shopee.Workspace.Behaviors"
             x:Name="Root">
    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource h1}" />
                <TextBlock Text="{Binding HeaderCaption}"
                           Style="{StaticResource caption}" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button MinWidth="160" Margin="0,0,10,0"
                        Visibility="{Binding IsNotRunning, Converter={StaticResource BoolToVis}}"
                        Command="{Binding RetryFailedSyncCommand}"
                        IsEnabled="{Binding HasFailedSyncs}"
                        ToolTip="Đồng bộ lại tất cả sản phẩm bị lỗi phiên/cookie (sử dụng dữ liệu JSON đã lưu, không cần cào lại Shopee)">
                    <StackPanel Orientation="Horizontal">
                        <c:PathIcon Data="{StaticResource IconRefresh}" />
                        <TextBlock Style="{StaticResource btnLabel}">
                            <Run Text="Đồng bộ SP lỗi (" /><Run Text="{Binding FailedSyncCount, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource primary}" MinWidth="160"
                        Visibility="{Binding IsNotRunning, Converter={StaticResource BoolToVis}}"
                        Command="{Binding StartScrapeMultiCommand}">
                    <StackPanel Orientation="Horizontal">
                        <c:PathIcon Data="{StaticResource IconPlay}" />
                        <TextBlock Style="{StaticResource btnLabel}" Text="Bắt đầu Scrape Multi" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource danger}" MinWidth="160"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                        Command="{Binding StopScrapeMultiCommand}">
                    <StackPanel Orientation="Horizontal">
                        <c:PathIcon Data="{StaticResource IconStop}" />
                        <TextBlock Style="{StaticResource btnLabel}" Text="Dừng Scrape Multi" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Row 1: Nội dung chính 2 cột -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460" MinWidth="340" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- Cột 0: Danh sách tài khoản -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Toolbar: Chọn tất cả, Bỏ chọn tất cả, Gán Proxy, Reset -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <WrapPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Command="{Binding SelectAllCommand}" IsEnabled="{Binding IsNotRunning}" Padding="8,4" Margin="0,0,6,4">
                            <StackPanel Orientation="Horizontal">
                                <c:PathIcon Data="{StaticResource IconCheckAll}" Width="11" Height="11" />
                                <TextBlock Style="{StaticResource btnLabel}" Margin="4,0,0,0" FontSize="11.5" Text="Chọn tất cả" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DeselectAllCommand}" IsEnabled="{Binding IsNotRunning}" Padding="8,4" Margin="0,0,6,4">
                            <StackPanel Orientation="Horizontal">
                                <c:PathIcon Data="{StaticResource IconUncheck}" Width="11" Height="11" />
                                <TextBlock Style="{StaticResource btnLabel}" Margin="4,0,0,0" FontSize="11.5" Text="Bỏ chọn" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding AutoAssignProxiesCommand}" IsEnabled="{Binding IsNotRunning}" Padding="8,4" Margin="0,0,6,4"
                                ToolTip="Tự động phân bổ key KiotProxy cho các tài khoản BigSeller">
                            <StackPanel Orientation="Horizontal">
                                <c:PathIcon Data="{StaticResource IconSave}" Width="11" Height="11" />
                                <TextBlock Style="{StaticResource btnLabel}" Margin="4,0,0,0" FontSize="11.5" Text="Gán Proxy" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ClearProxiesCommand}" IsEnabled="{Binding IsNotRunning}" Padding="8,4" Margin="0,0,6,4"
                                ToolTip="Reset toàn bộ proxy về IP máy trực tiếp (không dùng proxy)">
                            <StackPanel Orientation="Horizontal">
                                <c:PathIcon Data="{StaticResource IconClose}" Width="11" Height="11" />
                                <TextBlock Style="{StaticResource btnLabel}" Margin="4,0,0,0" FontSize="11.5" Text="Về IP máy" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ResetSelectedProgressAsyncCommand}" IsEnabled="{Binding IsNotRunning}" Padding="8,4" Margin="0,0,0,4"
                                ToolTip="Reset tiến độ Scrape của các tài khoản đang được chọn">
                            <StackPanel Orientation="Horizontal">
                                <c:PathIcon Data="{StaticResource IconRefresh}" Width="11" Height="11" />
                                <TextBlock Style="{StaticResource btnLabel}" Margin="4,0,0,0" FontSize="11.5" Text="Reset tiến độ" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}">
                        <Run Text="{Binding Accounts.Count, Mode=OneWay}" /><Run Text=" tài khoản" />
                    </TextBlock>
                </Grid>

                <!-- ScrollViewer chứa danh sách các thẻ tài khoản -->
                <Border Grid.Row="1" Style="{StaticResource card}" Padding="0" ClipToBounds="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Accounts}" Margin="12,10,12,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource card}" Padding="14,10" Margin="0,0,0,8"
                                            BorderBrush="{StaticResource BorderLightBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Checkbox -->
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                      IsEnabled="{Binding DataContext.IsNotRunning, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      VerticalAlignment="Center" Margin="0,0,12,0" />

                                            <!-- Account details -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <!-- Lead Badge -->
                                                    <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="3" VerticalAlignment="Center"
                                                            Visibility="{Binding IsLead, Converter={StaticResource BoolToVis}}"
                                                            Background="{StaticResource BrandTintBrush}" BorderBrush="{StaticResource BrandTintBorderStrongBrush}" BorderThickness="1">
                                                        <TextBlock Text="LEAD (BRAVE)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrandTextBrush}" />
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <!-- Cookie status -->
                                                    <TextBlock Text="{Binding CookieStatus}" FontSize="11">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasCookie}" Value="False">
                                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                             </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="·" FontSize="11" Margin="6,0" Foreground="{StaticResource IdleDotBrush}" />
                                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                                        <Run Text="{Binding ShopCount, Mode=OneWay}" /><Run Text=" shop" />
                                                    </TextBlock>
                                                    <TextBlock Text="·" FontSize="11" Margin="6,0" Foreground="{StaticResource IdleDotBrush}" />
                                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                                        <Run Text="{Binding CompletedCount, Mode=OneWay}" /><Run Text=" SP" />
                                                    </TextBlock>
                                                    <TextBlock Text="·" FontSize="11" Margin="6,0" Foreground="{StaticResource IdleDotBrush}" />
                                                    <!-- Proxy status -->
                                                    <TextBlock FontSize="11" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                                <Setter Property="Text" Value="{Binding ProxyKey, StringFormat='Proxy: {0}'}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasProxy}" Value="False">
                                                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                                        <Setter Property="Text" Value="IP máy (Trực tiếp)" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Status badge -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                                                <Border CornerRadius="4" Padding="10,4" Background="{StaticResource NeutralBadgeBgBrush}">
                                                    <TextBlock Text="{Binding Status}" FontSize="11.5" Foreground="{StaticResource TextBodyBrush}" FontWeight="Medium" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Cột 1: Spacing -->

            <!-- Cột 2: Cài đặt, Tiến trình realtime, Log -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Row 0: Panel Cài đặt chạy -->
                <Border Grid.Row="0" Style="{StaticResource card}" Padding="14,10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="CẤU HÌNH PHẠM VI &amp; TỐC ĐỘ" Style="{StaticResource caption}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <WrapPanel Grid.Row="1" Orientation="Horizontal" IsEnabled="{Binding IsNotRunning}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                                <TextBlock Text="Từ dòng:" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox Text="{Binding StartRow, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Width="65" Height="26" VerticalContentAlignment="Center" Padding="4,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                                <TextBlock Text="Đến dòng:" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox Text="{Binding EndRow, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Width="65" Height="26" VerticalContentAlignment="Center" Padding="4,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                                <TextBlock Text="Số cửa sổ (Process):" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox Text="{Binding MaxProcess, UpdateSourceTrigger=PropertyChanged}" Width="50" Height="26" VerticalContentAlignment="Center" Padding="4,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                                <TextBlock Text="Nghỉ min (s):" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox Text="{Binding RestMinSeconds, UpdateSourceTrigger=PropertyChanged}" Width="50" Height="26" VerticalContentAlignment="Center" Padding="4,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Nghỉ max (s):" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox Text="{Binding RestMaxSeconds, UpdateSourceTrigger=PropertyChanged}" Width="50" Height="26" VerticalContentAlignment="Center" Padding="4,0" />
                            </StackPanel>
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- Row 1: Banner tiến trình realtime -->
                <Border Grid.Row="1" Style="{StaticResource card}" Padding="14,10" Margin="0,0,0,10"
                        Background="{StaticResource BrandTintBrush}" BorderBrush="{StaticResource BrandTintBorderStrongBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Row="0">
                            <c:PathIcon Data="{StaticResource IconPlay}" Width="12" Height="12"
                                        Foreground="{StaticResource BrandTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Trạng thái hiện tại:" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource BrandTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentStatus}" FontSize="12"
                                       Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                       Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        
                        <TextBlock Grid.Row="1" Text="{Binding LeadProgressSummary}" FontSize="11.5"
                                   Foreground="{StaticResource BrandTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />

                        <ProgressBar Grid.Row="2" Height="3" IsIndeterminate="True" Margin="0,8,0,0"
                                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>

                <!-- Row 2: Cửa sổ LOG -->
                <Border Grid.Row="2" Style="{StaticResource card}" Padding="14,12" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header của Log -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="NHẬT KÝ SCRAPE MULTI (LOG)" Style="{StaticResource caption}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Padding="8,4" Margin="0,0,8,0" Command="{Binding ClearLogCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:PathIcon Data="{StaticResource IconRefresh}" Width="12" Height="12" />
                                        <TextBlock Style="{StaticResource btnLabel}" Margin="6,0,0,0" Text="Xoá log" />
                                    </StackPanel>
                                </Button>
                                <Button Padding="8,4" Command="{Binding OpenLogFileCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:PathIcon Data="{StaticResource IconFolder}" Width="12" Height="12" />
                                        <TextBlock Style="{StaticResource btnLabel}" Margin="6,0,0,0" Text="Mở file" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- TextBox hiển thị Log -->
                        <Border Grid.Row="1" CornerRadius="6" ClipToBounds="True" Background="{StaticResource LogBackgroundBrush}">
                            <TextBox Style="{StaticResource log}" b:LogText.Source="{Binding LogLines}" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
