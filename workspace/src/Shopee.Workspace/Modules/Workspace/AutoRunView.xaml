<UserControl x:Class="Shopee.Workspace.Modules.Workspace.AutoRunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Shopee.Workspace.Controls"
             xmlns:b="clr-namespace:Shopee.Workspace.Behaviors"
             x:Name="Root">
    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource h1}" />
                <TextBlock Text="{Binding HeaderCaption}"
                           Style="{StaticResource caption}" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource primary}" MinWidth="140"
                        Visibility="{Binding IsNotRunning, Converter={StaticResource BoolToVis}}"
                        Command="{Binding StartAutoRunCommand}">
                    <StackPanel Orientation="Horizontal">
                        <c:PathIcon Data="{StaticResource IconPlay}" />
                        <TextBlock Style="{StaticResource btnLabel}" Text="Bắt đầu Auto Run" />
                    </StackPanel>
                </Button>
                <Button MinWidth="110" Padding="12,0" Margin="0,0,10,0"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                        Command="{Binding NextShopCommand}"
                        ToolTip="Bỏ qua shop hiện tại, đánh dấu hoàn thành và chuyển sang shop kế tiếp">
                    <StackPanel Orientation="Horizontal">
                        <c:PathIcon Data="{StaticResource IconSkipNext}" Width="12" Height="12" />
                        <TextBlock Style="{StaticResource btnLabel}" Margin="6,0,0,0" Text="Next shop" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource danger}" MinWidth="140"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                        Command="{Binding StopAutoRunCommand}">
                    <StackPanel Orientation="Horizontal">
                        <c:PathIcon Data="{StaticResource IconStop}" />
                        <TextBlock Style="{StaticResource btnLabel}" Text="Dừng Auto Run" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Row 1: Nội dung chính 2 cột -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="320" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- Cột 0: Danh sách tài khoản -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Toolbar: Chọn tất cả, Bỏ chọn tất cả, số lượng -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Command="{Binding SelectAllCommand}" IsEnabled="{Binding IsNotRunning}" Padding="10,4" MinWidth="90">
                            <StackPanel Orientation="Horizontal">
                                <c:PathIcon Data="{StaticResource IconCheckAll}" />
                                <TextBlock Style="{StaticResource btnLabel}" Text="Chọn tất cả" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DeselectAllCommand}" IsEnabled="{Binding IsNotRunning}" Padding="10,4" MinWidth="90" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <c:PathIcon Data="{StaticResource IconUncheck}" />
                                <TextBlock Style="{StaticResource btnLabel}" Text="Bỏ chọn tất cả" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ResetSelectedProgressAsyncCommand}" IsEnabled="{Binding IsNotRunning}" Padding="10,4" MinWidth="110" Margin="8,0,0,0"
                                ToolTip="Reset toàn bộ tiến độ (Scrape · Import · Update) của tất cả shop thuộc các tài khoản đang được chọn">
                            <StackPanel Orientation="Horizontal">
                                <c:PathIcon Data="{StaticResource IconRefresh}" Width="12" Height="12" />
                                <TextBlock Style="{StaticResource btnLabel}" Margin="6,0,0,0" Text="Reset tiến độ đã chọn" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}">
                        <Run Text="{Binding Accounts.Count, Mode=OneWay}" /><Run Text=" tài khoản" />
                    </TextBlock>
                </Grid>

                <!-- ScrollViewer chứa danh sách các thẻ tài khoản -->
                <Border Grid.Row="1" Style="{StaticResource card}" Padding="0" ClipToBounds="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Accounts}" Margin="12,10,12,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource card}" Padding="14,10" Margin="0,0,0,8"
                                            BorderBrush="{StaticResource BorderLightBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Checkbox -->
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                      IsEnabled="{Binding DataContext.IsNotRunning, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      VerticalAlignment="Center" Margin="0,0,14,0" />

                                            <!-- Account details -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <!-- Cookie status -->
                                                    <TextBlock Text="{Binding CookieStatus}" FontSize="11">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasCookie}" Value="False">
                                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="·" FontSize="11" Margin="6,0" Foreground="{StaticResource IdleDotBrush}" />
                                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                                        <Run Text="{Binding ShopCount, Mode=OneWay}" /><Run Text=" shop" />
                                                    </TextBlock>
                                                    <TextBlock Text="·" FontSize="11" Margin="6,0" Foreground="{StaticResource IdleDotBrush}" />
                                                    <TextBlock Text="{Binding ShopsSummary}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Reset & Status -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <!-- Reset button per account -->
                                                <Button VerticalAlignment="Center" Padding="8,4" Margin="0,0,8,0"
                                                        Command="{Binding DataContext.ResetAccountProgressAsyncCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding DataContext.IsNotRunning, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        ToolTip="Reset toàn bộ tiến độ các shop thuộc tài khoản này">
                                                    <StackPanel Orientation="Horizontal">
                                                        <c:PathIcon Data="{StaticResource IconRefresh}" Width="10" Height="10" />
                                                        <TextBlock Style="{StaticResource btnLabel}" Margin="4,0,0,0" FontSize="11" Text="Reset" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- Status badge -->
                                                <Border VerticalAlignment="Center" CornerRadius="4" Padding="10,4"
                                                        Background="{StaticResource NeutralBadgeBgBrush}">
                                                    <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource TextBodyBrush}" FontWeight="Medium" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Cột 1: Spacing (Width="14") -->

            <!-- Cột 2: Tiến trình realtime + Log -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Row 0: Banner tiến trình realtime -->
                <Border Grid.Row="0" Style="{StaticResource card}" Padding="14,10" Margin="0,0,0,10"
                        Background="{StaticResource BrandTintBrush}" BorderBrush="{StaticResource BrandTintBorderStrongBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Row="0">
                            <c:PathIcon Data="{StaticResource IconPlay}" Width="12" Height="12"
                                        Foreground="{StaticResource BrandTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Trạng thái hiện tại:" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource BrandTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentStatus}" FontSize="12"
                                       Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                       Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ProgressBar Grid.Row="1" Height="3" IsIndeterminate="True" Margin="0,8,0,0"
                                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>

                <!-- Row 1: Cửa sổ LOG -->
                <Border Grid.Row="1" Style="{StaticResource card}" Padding="14,12" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header của Log -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="NHẬT KÝ HOẠT ĐỘNG (LOG)" Style="{StaticResource caption}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Padding="8,4" Margin="0,0,8,0" Command="{Binding ClearLogCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:PathIcon Data="{StaticResource IconRefresh}" Width="12" Height="12" />
                                        <TextBlock Style="{StaticResource btnLabel}" Margin="6,0,0,0" Text="Xoá log" />
                                    </StackPanel>
                                </Button>
                                <Button Padding="8,4" Command="{Binding OpenLogFileCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:PathIcon Data="{StaticResource IconFolder}" Width="12" Height="12" />
                                        <TextBlock Style="{StaticResource btnLabel}" Margin="6,0,0,0" Text="Mở file" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- TextBox hiển thị Log -->
                        <Border Grid.Row="1" CornerRadius="6" ClipToBounds="True" Background="{StaticResource LogBackgroundBrush}">
                            <TextBox Style="{StaticResource log}" b:LogText.Source="{Binding LogLines}" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
