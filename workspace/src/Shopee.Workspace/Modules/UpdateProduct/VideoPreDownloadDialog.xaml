<Window x:Class="Shopee.Workspace.Modules.UpdateProduct.VideoPreDownloadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kiểm tra video trước Update"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" WindowStyle="SingleBorderWindow"
        Topmost="True"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Loaded="Window_Loaded">
    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="⬇  Kiểm tra video trước khi Update"
                   FontSize="15" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,16"/>

        <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                   FontSize="13.5" LineHeight="20"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,12"/>

        <ProgressBar x:Name="Progress" Height="18" Minimum="0" Maximum="100"
                     Visibility="Collapsed" Margin="0,0,0,6"/>

        <TextBlock x:Name="DetailText" Foreground="Gray" FontSize="11"
                   TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,16"/>

        <StackPanel x:Name="BtnPanel" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="BtnDownload" Content="Tải về" Width="130" Margin="0,0,8,0"
                    Click="BtnDownload_Click" Visibility="Collapsed"/>
            <Button x:Name="BtnSkip" Content="Bỏ qua" Width="90" Margin="0,0,8,0"
                    Click="BtnSkip_Click" Visibility="Collapsed"/>
            <Button x:Name="BtnCancel" Content="Hủy" Width="90"
                    Click="BtnCancel_Click" Visibility="Collapsed"/>
            <Button x:Name="BtnOk" Content="OK" Width="90"
                    Click="BtnOk_Click" Visibility="Collapsed"/>
        </StackPanel>
    </StackPanel>
</Window>
