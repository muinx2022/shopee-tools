<UserControl x:Class="Shopee.Workspace.Modules.Harvest.HarvestSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hv="clr-namespace:Shopee.Workspace.Modules.Harvest"
             x:Name="Root">
    <!-- Màn "Cài đặt" DUY NHẤT của app Harvest: Kết nối Hub (đầu) · Hiệu năng · Thu phóng · Kho tài khoản & Proxy · Extension.
         Không có AI (màn chung LocalSettingsView của app Scrape / Update giữ nguyên). -->
    <UserControl.Resources>
        <Style x:Key="groupTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="group" TargetType="{x:Type Border}" BasedOn="{StaticResource card}">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="rowLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="150" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18,14,18,14" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource h1}" Text="Cài đặt" Margin="0,0,0,12" />

            <!-- 1. Kết nối Hub (nút "Cài đặt Hub" ở màn Lấy dữ liệu mở màn này — nhóm này ở ĐẦU màn). -->
            <Border x:Name="HubGroup" Style="{StaticResource group}">
                <hv:HarvestHubView DataContext="{Binding Hub}" />
            </Border>

            <!-- 2. Hiệu năng: trần cửa sổ Brave của cả app (Harvest mở Brave qua đúng trần này). -->
            <Border Style="{StaticResource group}" DataContext="{Binding General}">
                <StackPanel>
                    <TextBlock Style="{StaticResource groupTitle}" Text="Hiệu năng" />
                    <TextBlock Style="{StaticResource caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Giới hạn số cửa sổ Brave mở cùng lúc của cả app (kể cả 'Số cửa sổ' ở màn Lấy dữ liệu) theo CPU / RAM được dùng." />
                    <TextBlock Text="{Binding MachineInfo}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding ComputedMaxInfo}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource rowLabel}" Text="CPU được dùng:" />
                        <TextBox Text="{Binding UsableCpu, UpdateSourceTrigger=PropertyChanged}" Width="72" />
                        <TextBlock Text="{Binding CpuCoresMax, StringFormat= / {0} nhân}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource rowLabel}" Text="RAM được dùng (GB):" />
                        <TextBox Text="{Binding UsableRamGb, UpdateSourceTrigger=PropertyChanged}" Width="72" />
                        <TextBlock Text="{Binding RamGbMax, StringFormat= / {0} GB}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <Button Content="Lưu hiệu năng" Command="{Binding SavePerformanceCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- 3. Thu phóng giao diện. -->
            <Border Style="{StaticResource group}" DataContext="{Binding General}">
                <StackPanel>
                    <TextBlock Style="{StaticResource groupTitle}" Text="Thu phóng giao diện" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ZoomText}" VerticalAlignment="Center" Margin="0,0,16,0" FontFamily="Consolas" />
                        <Button Content="−" Command="{Binding ZoomOutCommand}" Width="32" Margin="0,0,4,0" />
                        <Button Content="100%" Command="{Binding ZoomResetCommand}" Margin="0,0,4,0" />
                        <Button Content="+" Command="{Binding ZoomInCommand}" Width="32" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 4. Kho tài khoản Shopee & Proxy (DB dùng chung với app Scrape). -->
            <Border Style="{StaticResource group}" DataContext="{Binding General}">
                <StackPanel>
                    <TextBlock Style="{StaticResource groupTitle}" Text="Kho tài khoản Shopee &amp; Proxy" />
                    <TextBlock Text="DB ShopeeBackend dùng chung:" Margin="0,0,0,4" />
                    <TextBox Text="{Binding ShopeeDbPath, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding StoreStatus}" Margin="0,0,0,4" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LockStatus}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,8"
                               Visibility="{Binding LockStatus, Converter={StaticResource StringToVis}}" />
                    <Button Content="Nạp lại từ DB" Command="{Binding ReloadStoreCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- 5. Extension shopee-harvest cạnh exe (cài lên máy khác: Load unpacked). -->
            <Border Style="{StaticResource group}">
                <StackPanel>
                    <TextBlock Style="{StaticResource groupTitle}" Text="Extension Shopee Harvest" />
                    <TextBox Text="{Binding ExtensionDir, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource caption}" Text="{Binding ExtensionHint}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <Button Content="Mở thư mục" Command="{Binding OpenExtensionFolderCommand}" HorizontalAlignment="Left"
                            IsEnabled="{Binding ExtensionDirExists}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
