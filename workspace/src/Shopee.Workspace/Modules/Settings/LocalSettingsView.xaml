<UserControl x:Class="Shopee.Workspace.Modules.Settings.LocalSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Shopee.Workspace.Modules.Settings"
             xmlns:c="clr-namespace:Shopee.Workspace.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">

            <TextBlock Text="Hiệu năng" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding MachineInfo}" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding ComputedMaxInfo}" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="CPU được dùng:" VerticalAlignment="Center" Width="120"/>
                <TextBox Text="{Binding UsableCpu, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                <TextBlock Text="{Binding CpuCoresMax, StringFormat= / {0} nhân}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="RAM được dùng (GB):" VerticalAlignment="Center" Width="120"/>
                <TextBox Text="{Binding UsableRamGb, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                <TextBlock Text="{Binding RamGbMax, StringFormat= / {0} GB}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
            <Button Content="Lưu hiệu năng" Command="{Binding SavePerformanceCommand}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="Thu phóng:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding ZoomText}" VerticalAlignment="Center" Margin="0,0,16,0" FontFamily="Consolas"/>
                <Button Content="−" Command="{Binding ZoomOutCommand}" Width="28" Margin="0,0,4,0"/>
                <Button Content="100%" Command="{Binding ZoomResetCommand}" Margin="0,0,4,0"/>
                <Button Content="+" Command="{Binding ZoomInCommand}" Width="28"/>
            </StackPanel>

            <Separator Margin="0,0,0,16"/>

            <TextBlock Text="AI" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
            <TextBlock Text="Nhà cung cấp:" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider}"
                      Width="200" HorizontalAlignment="Left" Margin="0,0,0,8"/>
            <TextBlock Text="OpenAI model / API key" Margin="0,0,0,4"/>
            <TextBox Text="{Binding OpenAiModel, UpdateSourceTrigger=PropertyChanged}" MaxWidth="360" HorizontalAlignment="Left" Margin="0,0,0,4"/>
            <c:RevealPasswordBox Password="{Binding OpenAiApiKey, Mode=TwoWay}" MaxWidth="400" HorizontalAlignment="Left" Margin="0,0,0,8"/>
            <TextBlock Text="Anthropic model / API key" Margin="0,0,0,4"/>
            <TextBox Text="{Binding AnthropicModel, UpdateSourceTrigger=PropertyChanged}" MaxWidth="360" HorizontalAlignment="Left" Margin="0,0,0,4"/>
            <c:RevealPasswordBox Password="{Binding AnthropicApiKey, Mode=TwoWay}" MaxWidth="400" HorizontalAlignment="Left" Margin="0,0,0,8"/>
            <TextBlock Text="Gemini model / API key" Margin="0,0,0,4"/>
            <TextBox Text="{Binding GeminiModel, UpdateSourceTrigger=PropertyChanged}" MaxWidth="360" HorizontalAlignment="Left" Margin="0,0,0,4"/>
            <c:RevealPasswordBox Password="{Binding GeminiApiKey, Mode=TwoWay}" MaxWidth="400" HorizontalAlignment="Left" Margin="0,0,0,8"/>
            <TextBlock Text="Batch size" Margin="0,0,0,4"/>
            <TextBox Text="{Binding BatchSize, UpdateSourceTrigger=PropertyChanged}" Width="60" HorizontalAlignment="Left" Margin="0,0,0,8"/>
            <TextBlock Text="Prompt viết lại tên (để trống = mặc định)" Margin="0,0,0,4"/>
            <TextBox Text="{Binding NameRewritePrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock Text="Prompt mô tả (để trống = mặc định)" Margin="0,0,0,4"/>
            <TextBox Text="{Binding DescriptionPrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Button Content="Lưu cấu hình AI" Command="{Binding SaveAiConfigCommand}" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding AiStatus}" VerticalAlignment="Center" Foreground="Green"/>
            </StackPanel>
            <TextBlock Text="API key lưu trên máy này, trong thư mục dữ liệu của app."
                       FontSize="11" Foreground="Gray" Margin="0,0,0,16"/>

            <Separator Margin="0,0,0,16"/>

            <TextBlock Text="Kho tài khoản &amp; Proxy" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
            <TextBlock Text="DB ShopeeBackend dùng chung:" Margin="0,0,0,4"/>
            <TextBox Text="{Binding ShopeeDbPath, Mode=OneWay}" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="11" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding StoreStatus}" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding LockStatus}" TextWrapping="Wrap" Foreground="#9B1C1C" Margin="0,0,0,8"/>
            <Button Content="Nạp lại từ DB" Command="{Binding ReloadStoreCommand}" HorizontalAlignment="Left"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
