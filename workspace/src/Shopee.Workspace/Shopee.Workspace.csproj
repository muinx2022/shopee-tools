<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms CHỈ để dùng System.Windows.Forms.Screen (WorkingArea đa màn hình) trong WindowFit —
         WPF không có API vùng làm việc của màn chứa cửa sổ. Không dùng control WinForms nào. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Shopee.Workspace</RootNamespace>
    <AssemblyName>ShopeeWorkspace</AssemblyName>
    <!-- Phiên bản cố định 1.0.0 — không đọc version.txt (đây là fork local). -->
    <Version>1.0.0</Version>
    <!-- Entry point THẬT là Program.Main — App.xaml vẫn là ApplicationDefinition nhưng Main sinh từ đây. -->
    <StartupObject>Shopee.Workspace.Program</StartupObject>
    <!-- DPI PerMonitorV2 — WPF chỉ nhận qua manifest. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\app-icon.ico</ApplicationIcon>
    <!-- WFAC010: analyzer WinForms đòi bỏ dpiAware khỏi manifest và dùng Application.SetHighDpiMode.
         Ở đây KHÔNG có app WinForms nào chạy — WPF bắt buộc khai PerMonitorV2 trong manifest. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <!-- SDK desktop tự thêm global using System.Windows.Forms + System.Drawing (vì UseWindowsForms) → VÀ TÊN
       với WPF ở hàng loạt kiểu (Control / TextBox / Brush / Timer / Application). Gỡ 2 using đó; WindowFit
       gọi System.Windows.Forms.Screen bằng tên đầy đủ. Đồng thời THÊM LẠI System.IO + System.Net.Http:
       danh sách implicit của SDK desktop không có 2 cái này. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\app-icon.ico" Link="Assets\app-icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shopee.Core\Shopee.Core.csproj" />
    <ProjectReference Include="..\Shopee.Module.CheckAccount\Shopee.Module.CheckAccount.csproj" />
    <ProjectReference Include="..\Shopee.Module.MultiBrave\Shopee.Module.MultiBrave.csproj" />
    <ProjectReference Include="..\Shopee.Module.UpdateProduct\Shopee.Module.UpdateProduct.csproj" />
  </ItemGroup>

  <!-- 📦 Gói kèm extension shopee-scrape vào output khi build/publish 📦 -->
  <PropertyGroup>
    <RepoRoot>$(MSBuildProjectDirectory)\..\..</RepoRoot>
  </PropertyGroup>
  <ItemGroup>
    <ScrapeExtFiles Include="$(RepoRoot)\extensions\shopee-scrape\**\*" />
  </ItemGroup>
  <Target Name="BundleWorkspaceAssets" AfterTargets="Build">
    <Copy SourceFiles="@(ScrapeExtFiles)" DestinationFiles="@(ScrapeExtFiles->'$(OutDir)extensions\shopee-scrape\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="BundleWorkspaceAssetsPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(ScrapeExtFiles)" DestinationFiles="@(ScrapeExtFiles->'$(PublishDir)extensions\shopee-scrape\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Shopee.Workspace.Tests" />
  </ItemGroup>
</Project>
