<Window x:Class="Shopee.Upload.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Shopee.Upload"
        xmlns:f="clr-namespace:Shopee.Upload.Forms"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
        Title="Shopee Upload"
        Icon="pack://application:,,,/Assets/app-icon.ico"
        Width="1320" Height="880" MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Ô số nhỏ (căn phải, mono). -->
        <Style x:Key="num" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
        <!-- Một ô có nhãn trên đầu. -->
        <Style x:Key="field" TargetType="{x:Type StackPanel}">
            <Setter Property="Margin" Value="0,0,12,10" />
        </Style>
    </Window.Resources>

    <Grid Margin="16,14,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <!-- ══════════ HEADER ══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Style="{StaticResource h1}" Text="Shopee Upload" />
                <TextBlock Style="{StaticResource caption}" Margin="0,3,0,0"
                           Visibility="{Binding ShowBrowserFeatures, Converter={StaticResource BoolToVis}}"
                           Text="Cấu hình proxy + tài khoản seller, mở Brave thử qua proxy rồi tự đăng nhập Shopee trong profile đó. Chưa đăng SP (chờ extension GĐ3)." />
                <TextBlock Style="{StaticResource caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                           Visibility="{Binding ShowExportFeatures, Converter={StaticResource BoolToVis}}"
                           Text="Xuất file xlsx theo mẫu Đăng Hàng Loạt của Shopee từ dữ liệu đã cào trên Hub. Bạn tự sửa file (tên, mô tả) rồi tự đẩy lên Shopee — app không truy cập Shopee." />
                <TextBlock Style="{StaticResource caption}" Margin="0,2,0,0" Foreground="{StaticResource TextMutedBrush}">
                    <Run Text="File cấu hình:" />
                    <Run Text="{Binding StorePath, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="● Có thay đổi chưa lưu" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center"
                           Margin="0,0,12,0" Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding SaveStatus}" Style="{StaticResource caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Command="{Binding SaveCommand}" MinWidth="96" ToolTip="Kiểm rồi lưu (có lỗi thì không lưu)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource btnGlyph}" Text="✔" Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Text="Lưu" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ══════════ LỖI / CẢNH BÁO (kiểm lại mỗi lần sửa ô) ══════════ -->
        <ScrollViewer Grid.Row="1" MaxHeight="130" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"
                      Visibility="{Binding HasErrors, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource DangerBgBrush}" CornerRadius="6" Padding="14,8">
                <StackPanel>
                    <TextBlock Text="Lỗi — sửa xong mới lưu được:" FontWeight="Medium" Foreground="{StaticResource DangerBrush}" />
                    <ItemsControl ItemsSource="{Binding Errors}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='• {0}'}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- ══════════ NỘI DUNG ══════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── Cột trái: proxy chung + nhịp chạy + cảnh báo ── -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,4,0">
                    <Border Style="{StaticResource card}" DataContext="{Binding Settings}" Margin="0,0,0,12"
                            Visibility="{Binding DataContext.ShowBrowserFeatures, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource h2}" Text="Proxy chung" />
                            <TextBlock Style="{StaticResource caption}" Margin="0,-4,0,10" TextWrapping="Wrap"
                                       Text="Có key Kiot: mỗi lần mở shop đổi IP mới. Không có key: mọi shop đi proxy tĩnh, cùng một IP (chỉ dùng để thử)." />
                            <StackPanel Style="{StaticResource field}" Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource fieldLabel}" Text="Key Kiot" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <local:RevealPasswordBox Password="{Binding KiotKey, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Key Kiot chung" />
                                    <TextBlock Grid.Column="1" Text="{Binding KiotKeyMask}" Margin="10,0,0,0" VerticalAlignment="Center"
                                               FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextSecondaryBrush}"
                                               ToolTip="Chỉ hiện 4 ký tự cuối" />
                                </Grid>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Style="{StaticResource field}">
                                    <TextBlock Style="{StaticResource fieldLabel}" Text="Vùng" />
                                    <ComboBox ItemsSource="{x:Static f:KiotRegions.All}" SelectedItem="{Binding Region}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Style="{StaticResource field}" Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource fieldLabel}" Text="Kiểu" />
                                    <ComboBox ItemsSource="{x:Static f:ProxySchemes.All}" SelectedItem="{Binding Type}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource warnText}" Margin="0,-4,0,0"
                                       Visibility="{Binding IsRandomRegion, Converter={StaticResource BoolToVis}}"
                                       Text="Vùng đang là random — nên chọn một vùng cố định (bac / trung / nam)." />
                            <!-- GĐ5d: proxy tĩnh chung — chỉ dùng khi không có key Kiot. -->
                            <StackPanel Style="{StaticResource field}" Margin="0,10,0,4">
                                <TextBlock Style="{StaticResource fieldLabel}" Text="Proxy tĩnh (dùng khi không có key Kiot)" />
                                <TextBox Style="{StaticResource mono}" Text="{Binding StaticProxy, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Proxy tĩnh chung"
                                         ToolTip="host:port[:user:pass], hoặc IP &lt;tab&gt; cổng [&lt;tab&gt; user &lt;tab&gt; pass] chép từ danh sách proxy" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource caption}" Margin="0,0,0,4" TextWrapping="Wrap" Text="{Binding StaticProxyPreview}" />
                            <TextBlock FontWeight="Medium" Margin="0,2,0,0" Text="{Binding ProxyInUse}" AutomationProperties.Name="Proxy chung đang dùng" />
                            <TextBlock Style="{StaticResource warnText}" Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding StaticIgnoredNote}"
                                       Visibility="{Binding StaticIgnoredNote, Converter={x:Static local:NullToVisibility.WhenNotNull}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource card}" Margin="0,0,0,12" DataContext="{Binding Settings}"
                            Visibility="{Binding DataContext.ShowBrowserFeatures, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource h2}" Text="Nhịp chạy" />
                            <TextBlock Style="{StaticResource caption}" Margin="0,-4,0,10"
                                       Text="Dùng khi chạy đăng SP (GĐ5). Nghỉ giữa 2 shop ≥ 5 phút để kịp đổi IP Kiot." />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Style="{StaticResource field}">
                                    <TextBlock Style="{StaticResource fieldLabel}" Text="Nghỉ giữa file: từ" />
                                    <TextBox Style="{StaticResource num}" Text="{Binding PauseFilesMin, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Style="{StaticResource field}" Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource fieldLabel}" Text="đến (phút)" />
                                    <TextBox Style="{StaticResource num}" Text="{Binding PauseFilesMax, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Style="{StaticResource field}">
                                    <TextBlock Style="{StaticResource fieldLabel}" Text="Nghỉ giữa shop: từ" />
                                    <TextBox Style="{StaticResource num}" Text="{Binding PauseShopsMin, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Style="{StaticResource field}" Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource fieldLabel}" Text="đến (phút)" />
                                    <TextBox Style="{StaticResource num}" Text="{Binding PauseShopsMax, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Style="{StaticResource field}" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource fieldLabel}" Text="Chạy từ giờ (0–23)" />
                                    <TextBox Style="{StaticResource num}" Text="{Binding ActiveFromHour, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Style="{StaticResource field}" Margin="0">
                                    <TextBlock Style="{StaticResource fieldLabel}" Text="đến giờ (1–24)" />
                                    <TextBox Style="{StaticResource num}" Text="{Binding ActiveToHour, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- GĐ8: ảnh bảng size + thư mục xuất (cấu hình chung). -->
                    <Border Style="{StaticResource card}" Margin="0,0,0,12" DataContext="{Binding Settings}"
                            Visibility="{Binding DataContext.ShowExportFeatures, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource h2}" Text="Cấu hình xuất" />
                            <StackPanel Style="{StaticResource field}" Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource fieldLabel}" Text="Ảnh bảng size dùng chung (cột O của mọi SP)" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource mono}" Text="{Binding SizeChartImagePath, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Ảnh bảng size" />
                                    <Button Grid.Column="1" Content="Chọn…" Margin="6,0,0,0" AutomationProperties.Name="Chọn ảnh bảng size"
                                            Command="{Binding DataContext.PickSizeChartCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Style="{StaticResource field}" Margin="0">
                                <TextBlock Style="{StaticResource fieldLabel}" Text="Thư mục ghi file xuất" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource mono}" Text="{Binding ExportDirectory, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Thư mục xuất" />
                                    <Button Grid.Column="1" Content="Chọn…" Margin="6,0,0,0" AutomationProperties.Name="Chọn thư mục xuất"
                                            Command="{Binding DataContext.PickExportFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </Grid>
                            </StackPanel>
                            <!-- GĐ9: ảnh SP lấy link kho ảnh gốc trên Hub; ảnh Hub chưa có thì tải CDN (mặc định) hoặc bỏ SP. -->
                            <TextBlock Style="{StaticResource fieldLabel}" Margin="0,10,0,4" Text="Ảnh chưa có trên Hub" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton GroupName="missingHub" Content="Tải từ CDN" AutomationProperties.Name="Ảnh chưa có trên Hub: tải từ CDN"
                                             IsChecked="{Binding DownloadMissingFromCdn}" />
                                <RadioButton GroupName="missingHub" Content="Bỏ SP" AutomationProperties.Name="Ảnh chưa có trên Hub: bỏ SP"
                                             IsChecked="{Binding SkipMissingHubImages}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- GĐ8: ảnh tạm trên Hub theo lượt xuất. -->
                    <Border Style="{StaticResource card}" Margin="0,0,0,12"
                            Visibility="{Binding ShowExportFeatures, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource h2}" Text="Ảnh tạm theo lượt" />
                            <TextBlock Style="{StaticResource warnText}" Margin="0,-4,0,8" TextWrapping="Wrap" Text="{Binding ClearWarningText}" />
                            <ListView ItemsSource="{Binding Batches}" SelectedItem="{Binding SelectedBatch}" MaxHeight="220" MinHeight="80"
                                      AutomationProperties.Name="Danh sách lượt xuất" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Ngày" Width="100" DisplayMemberBinding="{Binding When}" />
                                        <GridViewColumn Header="Shop" Width="100" DisplayMemberBinding="{Binding Shop}" />
                                        <GridViewColumn Header="Ảnh" Width="44" DisplayMemberBinding="{Binding Images}" />
                                        <GridViewColumn Header="Đã xoá?" Width="62" DisplayMemberBinding="{Binding ClearedText}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <TextBlock Style="{StaticResource caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding SelectedBatch, Converter={x:Static local:NullToVisibility.WhenNotNull}}">
                                <Run Text="{Binding SelectedBatch.State, Mode=OneWay}" />
                                <Run Text="·" />
                                <Run Text="{Binding SelectedBatch.Expiry, Mode=OneWay}" />
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Command="{Binding ClearBatchCommand}" Margin="0,0,6,0" AutomationProperties.Name="Xoá ảnh tạm của lượt"
                                        ToolTip="Xoá trên Hub các ảnh của lượt đang chọn (không xoá ảnh lượt khác còn dùng). Chỉ bấm sau khi đã đẩy file lên Shopee.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource btnGlyph}" Text="✕" Foreground="{StaticResource DangerBrush}" />
                                        <TextBlock Text="Xoá ảnh tạm của lượt" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding RefreshBatchesCommand}" Content="Làm mới" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- GĐ9: dung lượng Hub + xoá sạch kho ảnh gốc Harvest. -->
                    <Border Style="{StaticResource card}" Margin="0,0,0,12"
                            Visibility="{Binding ShowExportFeatures, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource h2}" Text="Dung lượng Hub" />
                            <Grid Margin="0,-2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource caption}" Text="Ổ đĩa" Margin="0,0,10,2" />
                                <TextBlock Grid.Column="1" Text="{Binding HubDiskText}" TextWrapping="Wrap" AutomationProperties.Name="Ổ đĩa Hub" />
                                <TextBlock Grid.Row="1" Style="{StaticResource caption}" Text="Kho ảnh gốc" Margin="0,0,10,2" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HubSourceText}" TextWrapping="Wrap" AutomationProperties.Name="Kho ảnh gốc" />
                                <TextBlock Grid.Row="2" Style="{StaticResource caption}" Text="Kho tạm" Margin="0,0,10,2" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding HubMediaText}" TextWrapping="Wrap" AutomationProperties.Name="Kho tạm" />
                            </Grid>
                            <TextBlock Style="{StaticResource caption}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding HubStorageStatus}" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button Command="{Binding RefreshHubStorageCommand}" Content="Làm mới" Margin="0,0,6,6"
                                        AutomationProperties.Name="Làm mới dung lượng Hub" />
                                <Button Command="{Binding DeleteAllSourceImagesCommand}" Margin="0,0,0,6" AutomationProperties.Name="Xoá ảnh gốc Harvest trên Hub"
                                        ToolTip="Xoá SẠCH kho ảnh gốc do Harvest đẩy lên (có hỏi lại). File đã xuất mà chưa đẩy lên Shopee sẽ hỏng ảnh.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource btnGlyph}" Text="✕" Foreground="{StaticResource DangerBrush}" />
                                        <TextBlock Text="Xoá ảnh gốc Harvest trên Hub" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource WarningBgBrush}" CornerRadius="6" Padding="14,10" Margin="0"
                            Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Cảnh báo (vẫn lưu được):" FontWeight="Medium" Foreground="{StaticResource WarningBrush}" />
                            <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='• {0}'}" Foreground="{StaticResource WarningBrush}"
                                                   TextWrapping="Wrap" Margin="0,0,0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ── Cột giữa: danh sách tài khoản ── -->
            <Border Grid.Column="2" Style="{StaticResource card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource h2}">
                        <Run Text="Shop" />
                        <Run Text="{Binding Accounts.Count, Mode=OneWay, StringFormat='({0})'}" Foreground="{StaticResource TextMutedBrush}" />
                    </TextBlock>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Command="{Binding AddCommand}" Margin="0,0,6,0" ToolTip="Thêm shop (mã tự sinh)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource btnGlyph}" Text="+" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="Thêm" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ToggleCommand}" Content="Bật/Tắt" Margin="0,0,6,0" />
                        <Button Command="{Binding DeleteCommand}" ToolTip="Xoá shop khỏi danh sách">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource btnGlyph}" Text="✕" Foreground="{StaticResource DangerBrush}" />
                                <TextBlock Text="Xoá" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <!-- GĐ5c: chỉ thêm/điền vào form, chưa lưu. -->
                    <WrapPanel Grid.Row="2" Margin="0,0,0,10">
                        <Button Command="{Binding ImportShopsCommand}" Content="Nhập shop từ BigSeller" Margin="0,0,6,6"
                                ToolTip="Mỗi shop trong cấu hình BigSeller chưa có trong danh sách → thêm một shop, điền sẵn file Excel nguồn + sheet (xem trước rồi mới thêm, chưa lưu)" />
                        <Button Command="{Binding ImportPasswordsCommand}" Content="Nhập mật khẩu từ Excel" Margin="0,0,0,6"
                                Visibility="{Binding ShowBrowserFeatures, Converter={StaticResource BoolToVis}}"
                                ToolTip="Đọc cột ACC, Pass, mail, pass Mail của file .xlsx rồi điền vào tài khoản khớp (chưa lưu)" />
                    </WrapPanel>
                    <ListBox Grid.Row="3" ItemsSource="{Binding Accounts}" SelectedItem="{Binding Selected}"
                             BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource acctListItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type f:AccountForm}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="dot" Width="8" Height="8" Margin="0,5,9,0" VerticalAlignment="Top"
                                             Fill="{StaticResource SuccessDotBrush}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="name" Text="{Binding DisplayName}" FontWeight="Medium"
                                                   Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource caption}" FontSize="11.5" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding DataContext.ShowBrowserFeatures, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                            <Run Text="{Binding Id, Mode=OneWay}" />
                                            <Run Text="·" />
                                            <Run Text="{Binding ProxySummary, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource caption}" FontSize="11.5" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding DataContext.ShowExportFeatures, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                            <Run Text="{Binding Id, Mode=OneWay}" />
                                            <Run Text="·" />
                                            <Run Text="{Binding Sheet, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                        <Setter TargetName="dot" Property="Fill" Value="{StaticResource IdleDotBrush}" />
                                        <Setter TargetName="name" Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ── Cột phải: sửa tài khoản đang chọn ── -->
            <Border Grid.Column="4" Style="{StaticResource card}" Padding="0">
                <Grid>
                    <TextBlock Style="{StaticResource caption}" Margin="16" Text="Chưa có shop nào — bấm Thêm."
                               Visibility="{Binding Selected, Converter={x:Static local:NullToVisibility.WhenNull}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Selected}"
                                  Visibility="{Binding Converter={x:Static local:NullToVisibility.WhenNotNull}}">
                        <StackPanel Margin="16,14,16,14">
                            <TextBlock Style="{StaticResource h2}" Margin="0,0,0,2" Text="{Binding DisplayName}" />
                            <TextBlock Style="{StaticResource caption}" Margin="0,0,0,10">
                                <Run Text="Mã:" />
                                <Run Text="{Binding Id, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                                <Run Text="(tự sinh, cố định)" Foreground="{StaticResource TextMutedBrush}" />
                            </TextBlock>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Style="{StaticResource field}">
                                    <TextBlock Style="{StaticResource fieldLabel}" Text="Nhãn (tên shop)" />
                                    <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}" Content="Bật"
                                          VerticalAlignment="Center" Margin="0,8,0,0" />
                            </Grid>

                            <StackPanel Visibility="{Binding DataContext.ShowBrowserFeatures, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource section}" Text="THƯ MỤC PROFILE BRAVE" />
                            <StackPanel Style="{StaticResource field}" Margin="0,0,0,4">
                                <TextBlock Style="{StaticResource fieldLabel}" Text="Thư mục riêng (để trống = mặc định)" />
                                <TextBox Style="{StaticResource mono}" Text="{Binding ProfileDir, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource caption}">
                                <Run Text="Đường dẫn thật:" />
                                <Run Text="{Binding ResolvedProfileDir, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                            </TextBlock>

                            <TextBlock Style="{StaticResource section}" Text="PROXY" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton GroupName="proxyKind" Content="Dùng proxy chung" IsChecked="{Binding IsSharedProxy}" />
                                <RadioButton GroupName="proxyKind" Content="Key Kiot riêng" IsChecked="{Binding IsKiotOwnProxy}" />
                                <RadioButton GroupName="proxyKind" Content="Proxy tĩnh" IsChecked="{Binding IsStaticProxy}" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource caption}" Margin="0,0,0,6"
                                       Visibility="{Binding IsSharedProxy, Converter={StaticResource BoolToVis}}"
                                       Text="Đi proxy chung ở cột trái: key Kiot (đổi IP mới mỗi lần mở), không có key thì proxy tĩnh chung." />

                            <StackPanel Visibility="{Binding IsKiotOwnProxy, Converter={StaticResource BoolToVis}}">
                                <StackPanel Style="{StaticResource field}" Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource fieldLabel}" Text="Key Kiot riêng" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <local:RevealPasswordBox Password="{Binding OwnKiotKey, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Key Kiot riêng" />
                                        <TextBlock Grid.Column="1" Text="{Binding OwnKiotKeyMask}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Grid>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Style="{StaticResource field}">
                                        <TextBlock Style="{StaticResource fieldLabel}" Text="Vùng" />
                                        <ComboBox ItemsSource="{x:Static f:KiotRegions.All}" SelectedItem="{Binding OwnRegion}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Style="{StaticResource field}">
                                        <TextBlock Style="{StaticResource fieldLabel}" Text="Kiểu" />
                                        <ComboBox ItemsSource="{x:Static f:ProxySchemes.All}" SelectedItem="{Binding OverrideType}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding OwnKeepIp}" VerticalAlignment="Center" Margin="0,8,0,0"
                                              Content="Giữ IP (không đổi IP mỗi lần mở)" />
                                </Grid>
                                <TextBlock Style="{StaticResource warnText}" Margin="0,-4,0,6"
                                           Visibility="{Binding IsOwnRegionRandom, Converter={StaticResource BoolToVis}}"
                                           Text="Vùng đang là random — nên chọn một vùng cố định." />
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsStaticProxy, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Style="{StaticResource field}">
                                        <TextBlock Style="{StaticResource fieldLabel}" Text="host:port[:user:pass] hoặc host &lt;tab&gt; port" />
                                        <TextBox Style="{StaticResource mono}" Text="{Binding StaticProxy, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Style="{StaticResource field}" Margin="0,0,0,10">
                                        <TextBlock Style="{StaticResource fieldLabel}" Text="Kiểu (khi không ghi scheme)" />
                                        <ComboBox ItemsSource="{x:Static f:ProxySchemes.All}" SelectedItem="{Binding OverrideType}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource caption}" Margin="0,-4,0,6" Text="{Binding StaticProxyPreview}" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource section}" Text="ĐĂNG NHẬP SHOPEE (NÚT &quot;MỞ + ĐĂNG NHẬP SHOPEE&quot;)" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Style="{StaticResource field}">
                                    <TextBlock Style="{StaticResource fieldLabel}" Text="Tài khoản Shopee (SĐT / tên / email)" />
                                    <TextBox Text="{Binding ShopeeLogin, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Style="{StaticResource field}" Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource fieldLabel}" Text="Mật khẩu Shopee (tối đa 16 ký tự)" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <local:RevealPasswordBox Password="{Binding ShopeePassword, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Mật khẩu Shopee" />
                                        <TextBlock Grid.Column="1" Text="{Binding ShopeePasswordMask}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextSecondaryBrush}"
                                                   ToolTip="Chỉ hiện 4 ký tự cuối" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Style="{StaticResource field}">
                                    <TextBlock Style="{StaticResource fieldLabel}" Text="Email xác minh (Hotmail/Outlook)" />
                                    <TextBox Text="{Binding VerifyEmail, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Style="{StaticResource field}" Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource fieldLabel}" Text="Mật khẩu email" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <local:RevealPasswordBox Password="{Binding VerifyEmailPassword, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Mật khẩu email" />
                                        <TextBlock Grid.Column="1" Text="{Binding VerifyEmailPasswordMask}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextSecondaryBrush}"
                                                   ToolTip="Chỉ hiện 4 ký tự cuối" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource caption}" Margin="0,-4,0,6" TextWrapping="Wrap"
                                       Text="Shopee đòi mã thì app mở Hotmail ở tab mới (chỉ đăng nhập, không đọc mail) — bạn tự lấy mã và nhập; app tự nhận khi đăng nhập xong. Sai mật khẩu thì dừng, không thử lại. Mật khẩu lưu thường trong file cấu hình, không mã hoá." />
                            </StackPanel>


                            <TextBlock Style="{StaticResource section}" Text="NGUỒN SP" />
                            <StackPanel Style="{StaticResource field}" Margin="0,0,0,10"
                                        Visibility="{Binding DataContext.ShowExportFeatures, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource fieldLabel}" Text="File Excel nguồn (link SP, như app Harvest)" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource mono}" Text="{Binding WorkbookPath, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="File Excel nguồn" />
                                    <Button Grid.Column="1" Content="Chọn…" Margin="6,0,0,0" AutomationProperties.Name="Chọn file Excel nguồn"
                                            Command="{Binding DataContext.PickWorkbookCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </Grid>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Style="{StaticResource field}" Width="180" Visibility="{Binding DataContext.ShowBrowserFeatures, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource fieldLabel}" Text="TK BigSeller" />
                                    <TextBox Text="{Binding BigSellerAccount, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Style="{StaticResource field}">
                                    <TextBlock Style="{StaticResource fieldLabel}" Text="Sheet" />
                                    <ComboBox IsEditable="True" Text="{Binding Sheet, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Sheet"
                                              ItemsSource="{Binding DataContext.SheetNames, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Style="{StaticResource field}">
                                    <TextBlock Style="{StaticResource fieldLabel}" Text="Từ dòng (Excel)" />
                                    <TextBox Style="{StaticResource num}" Text="{Binding FromRow, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Từ dòng" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Style="{StaticResource field}" Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource fieldLabel}" Text="Đến dòng (0 = hết)" />
                                    <TextBox Style="{StaticResource num}" Text="{Binding ToRow, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Đến dòng" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource caption}" Margin="0,-4,0,6"
                                       Text="{Binding DataContext.SheetStatus, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Visibility="{Binding DataContext.ShowExportFeatures, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

                            <StackPanel Visibility="{Binding DataContext.ShowExportFeatures, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource section}" Text="FILE MẪU SHOPEE (BẢN NÂNG CAO, MỖI FILE MỘT NGÀNH CẤP 1)" />
                                <TextBlock Style="{StaticResource caption}" Margin="0,-2,0,6" TextWrapping="Wrap"
                                           Text="Tải ở Shopee: Đăng Hàng Loạt → Tải về Bản Mẫu → Bản mẫu nâng cao → chọn ngành cấp 1. SP vào mẫu đúng ngành; ngành không có mẫu thì báo thiếu, không xuất. Bản basic nhận mọi ngành còn lại (không có thuộc tính → SP vào Bản nháp)." />
                                <ListBox ItemsSource="{Binding DataContext.Templates, RelativeSource={RelativeSource AncestorType=Window}}"
                                         SelectedItem="{Binding DataContext.SelectedTemplate, RelativeSource={RelativeSource AncestorType=Window}}"
                                         MinHeight="40" MaxHeight="160" AutomationProperties.Name="Danh sách file mẫu"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <TextBlock Text="{Binding FileName}" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                                <TextBlock Style="{StaticResource caption}" Text="{Binding Info}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="Thêm file mẫu…" Margin="0,0,6,0"
                                            Command="{Binding DataContext.AddTemplatesCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <Button Content="Bỏ file mẫu đang chọn"
                                            Command="{Binding DataContext.RemoveTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Style="{StaticResource section}" Text="GIÁ TRỊ MẶC ĐỊNH CHO FILE ĐĂNG" />
                            <UniformGrid Columns="3">
                                <StackPanel Style="{StaticResource field}">
                                    <TextBlock Style="{StaticResource fieldLabel}" Text="Tồn kho mỗi phân loại" />
                                    <TextBox Style="{StaticResource num}" Text="{Binding StockPerVariation, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource field}">
                                    <TextBlock Style="{StaticResource fieldLabel}" Text="Cân nặng (g)" />
                                    <TextBox Style="{StaticResource num}" Text="{Binding WeightGrams, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource field}">
                                    <TextBlock Style="{StaticResource fieldLabel}" Text="SP mỗi file (1–100)" />
                                    <TextBox Style="{StaticResource num}" Text="{Binding ProductsPerFile, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource field}">
                                    <TextBlock Style="{StaticResource fieldLabel}" Text="Dài (cm)" />
                                    <TextBox Style="{StaticResource num}" Text="{Binding LengthCm, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource field}">
                                    <TextBlock Style="{StaticResource fieldLabel}" Text="Rộng (cm)" />
                                    <TextBox Style="{StaticResource num}" Text="{Binding WidthCm, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource field}">
                                    <TextBlock Style="{StaticResource fieldLabel}" Text="Cao (cm)" />
                                    <TextBox Style="{StaticResource num}" Text="{Binding HeightCm, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </UniformGrid>

                            <StackPanel Visibility="{Binding DataContext.ShowBrowserFeatures, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource section}" Text="TRẦN" />
                                <StackPanel Style="{StaticResource field}" HorizontalAlignment="Left" Width="200" Margin="0">
                                    <TextBlock Style="{StaticResource fieldLabel}" Text="SP đăng tối đa mỗi ngày" />
                                    <TextBox Style="{StaticResource num}" Text="{Binding DailyProductCap, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════ BRAVE THỬ ══════════ -->
        <Border Grid.Row="3" Style="{StaticResource card}" Margin="0,12,0,10" Padding="16,10"
                Visibility="{Binding ShowBrowserFeatures, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding BrowserStatus}"
                               TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource caption}" Text="{Binding Countdown}" Foreground="{StaticResource BrandTextBrush}"
                               Visibility="{Binding IsOpening, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Style="{StaticResource caption}" Margin="0,2,0,0"
                               Text="Brave mở trang trắng qua proxy (đã kiểm IP ra ≠ IP máy). Tự gõ browserleaks.com/webrtc để kiểm, rồi vào banhang.shopee.vn đăng nhập — hoặc bấm &quot;Mở + đăng nhập Shopee&quot; để app tự đăng nhập. Mỗi lúc một Brave; tắt app thì Brave đóng theo." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding OpenBraveCommand}" Margin="0,0,6,0" ToolTip="Mở Brave cho tài khoản đang chọn">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource btnGlyph}" Text="▶" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="Mở Brave qua proxy" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenAndLoginCommand}" Margin="0,0,6,0"
                            ToolTip="Mở Brave qua proxy rồi tự đăng nhập Shopee bằng tài khoản đang nhập trên form">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource btnGlyph}" Text="▶" Foreground="{StaticResource SuccessBrush}" />
                            <TextBlock Text="Mở + đăng nhập Shopee" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CancelOpenCommand}" Content="Huỷ" Margin="0,0,6,0"
                            ToolTip="Huỷ lượt mở, hoặc dừng luồng đăng nhập (Brave để nguyên)" />
                    <Button Command="{Binding CloseBraveCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource btnGlyph}" Text="■" Foreground="{StaticResource DangerBrush}" />
                            <TextBlock Text="Đóng Brave" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════ XUẤT XLSX (GĐ8) ══════════ -->
        <Border Grid.Row="3" Style="{StaticResource card}" Margin="0,12,0,10" Padding="16,10"
                Visibility="{Binding ShowExportFeatures, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding ExportStatus}"
                               TextWrapping="Wrap" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding ExportPercent, Mode=OneWay}"
                                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderLightBrush}" BorderThickness="0"
                                     AutomationProperties.Name="Tiến trình xuất" />
                        <TextBlock Grid.Column="1" Style="{StaticResource caption}" Margin="10,0,0,0" MinWidth="110"
                                   Text="{Binding ExportStepText}" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ExportCommand}" Margin="0,0,6,0" AutomationProperties.Name="Xuất xlsx"
                            ToolTip="Xuất file xlsx cho shop đang chọn (theo giá trị đang trên form)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource btnGlyph}" Text="▶" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="Xuất xlsx" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CancelExportCommand}" Content="Huỷ" Margin="0,0,6,0" AutomationProperties.Name="Huỷ xuất"
                            ToolTip="Huỷ lượt xuất (không để lại file dở)" />
                    <Button Command="{Binding OpenExportFolderCommand}" Content="Mở thư mục" Margin="0,0,6,0" AutomationProperties.Name="Mở thư mục xuất" />
                    <Button Command="{Binding RetryFailedImagesCommand}" Content="Làm lại ảnh lỗi" AutomationProperties.Name="Làm lại ảnh lỗi"
                            ToolTip="Đưa mọi ảnh lỗi của shop đang chọn về chờ làm lại (lần Xuất sau tải lại)" />
                </StackPanel>
                <TextBox Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" MaxHeight="110" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontFamily="{StaticResource MonoFont}"
                         Text="{Binding ExportResultText, Mode=OneWay}" AutomationProperties.Name="Kết quả xuất"
                         Visibility="{Binding ExportResultText, Converter={x:Static local:NullToVisibility.WhenNotEmpty}}" />
            </Grid>
        </Border>

        <!-- ══════════ LOG ══════════ -->
        <TextBox x:Name="LogBox" Grid.Row="4" Style="{StaticResource log}" Text="{Binding LogText, Mode=OneWay}" />
    </Grid>
</Window>
