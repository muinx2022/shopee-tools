<UserControl x:Class="Shopee.Upload.RevealPasswordBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Shopee.Upload"
             x:Name="Root" Focusable="False" IsTabStop="False">
    <!-- Ô mật khẩu + nút con mắt. Ẩn: PasswordBox (bind qua PasswordAssist). Hiện: TextBox — chữ chỉ nạp khi đang hiện, ẩn lại thì
         xoá trắng (code-behind), để giá trị không nằm sẵn trong một ô bị che. Không đặt DataContext ở đây: binding ngoài cửa sổ
         (Password="{Binding …}") phải đi theo DataContext của chỗ đặt control. -->
    <Grid>
        <PasswordBox x:Name="Hidden" Padding="9,4,34,4"
                     local:PasswordAssist.BoundPassword="{Binding Password, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{Binding (AutomationProperties.Name), ElementName=Root}" />
        <TextBox x:Name="Shown" Padding="9,4,34,4" Visibility="Collapsed" IsUndoEnabled="False"
                 AutomationProperties.Name="{Binding (AutomationProperties.Name), ElementName=Root}" />
        <ToggleButton x:Name="Eye" Style="{StaticResource eyeToggle}" HorizontalAlignment="Right" Margin="0,0,3,0"
                      IsChecked="{Binding IsRevealed, ElementName=Root}" />
    </Grid>
</UserControl>
