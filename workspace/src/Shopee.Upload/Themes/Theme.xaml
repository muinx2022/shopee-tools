<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Bản rút gọn theme của Shopee.Workspace (Themes/Theme.xaml): CÙNG bảng màu + dáng nút/ô nhập/thẻ, chép tay vì app đăng SP
         không tham chiếu Shopee.Workspace (theme gốc dùng control/behavior của project đó). Đổi màu ở theme gốc thì chép sang. -->

    <!-- ══════════ MÀU ══════════ -->
    <SolidColorBrush x:Key="AccentBrush" Color="#EE4D2D" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#1F8A4C" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C22B1E" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B06F06" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F7F5F3" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E2DDD8" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#FBFAF9" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#E5E1DD" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="#EBE7E3" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F6F3F0" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="#CFC8C2" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#FAF8F6" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#F2EFEC" />
    <SolidColorBrush x:Key="BrandTextBrush" Color="#C93B1D" />
    <SolidColorBrush x:Key="BrandTintBrush" Color="#FFF3EF" />
    <SolidColorBrush x:Key="BrandTintBorderBrush" Color="#FBD6CA" />
    <SolidColorBrush x:Key="SuccessBgBrush" Color="#EAFAF0" />
    <SolidColorBrush x:Key="SuccessDotBrush" Color="#3FA860" />
    <SolidColorBrush x:Key="WarningBgBrush" Color="#FFF6E6" />
    <SolidColorBrush x:Key="DangerBgBrush" Color="#FDECEB" />
    <SolidColorBrush x:Key="IdleDotBrush" Color="#D3CCC7" />
    <SolidColorBrush x:Key="LogBackgroundBrush" Color="#121212" />
    <SolidColorBrush x:Key="LogForegroundBrush" Color="#E8E8E8" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#2C2724" />
    <SolidColorBrush x:Key="TextBodyBrush" Color="#423C38" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#675F5A" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8B837D" />

    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="ControlContentFontSize">12.5</sys:Double>

    <!-- ══════════ CHỮ ══════════ -->
    <Style x:Key="h1" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="h2" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style x:Key="caption" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="section" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="Margin" Value="0,12,0,6" />
    </Style>
    <Style x:Key="fieldLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Margin" Value="0,0,0,5" />
    </Style>
    <Style x:Key="warnText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource caption}">
        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <!-- ══════════ NÚT — một dáng (nền trắng, viền, bo 4, cao 30) ══════════ -->
    <Style TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Foreground" Value="{StaticResource TextBodyBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="PART_bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" SnapsToDevicePixels="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_bd" Property="Background" Value="{StaticResource ButtonHoverBrush}" />
                            <Setter TargetName="PART_bd" Property="BorderBrush" Value="{StaticResource InputHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PART_bd" Property="Background" Value="{StaticResource ButtonPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Ký hiệu màu trong nút (theme gốc tô màu icon, chữ vẫn màu thường). -->
    <Style x:Key="btnGlyph" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,7,0" />
    </Style>

    <!-- ══════════ Ô NHẬP ══════════ -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource ControlContentFontSize}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="PART_BorderElement" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_BorderElement" Property="BorderBrush" Value="{StaticResource InputHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="PART_BorderElement" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="PART_BorderElement" Property="Background" Value="{StaticResource SubtleBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_BorderElement" Property="Background" Value="{StaticResource SubtleBrush}" />
                            <Setter TargetName="PART_BorderElement" Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="mono" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="log" TargetType="{x:Type TextBox}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource LogForegroundBrush}" />
        <Setter Property="Background" Value="{StaticResource LogBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type PasswordBox}">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource ControlContentFontSize}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="PasswordChar" Value="●" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type PasswordBox}">
                    <Border x:Name="PART_BorderElement" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_BorderElement" Property="BorderBrush" Value="{StaticResource InputHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="PART_BorderElement" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nút con mắt nằm trong mép phải ô mật khẩu (RevealPasswordBox): mắt = đang ẩn, bấm để hiện; mắt gạch = đang hiện.
         Tooltip/automation name chỉ nói hành động, KHÔNG chứa giá trị. -->
    <Style x:Key="eyeToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="24" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ToolTip" Value="Hiện mật khẩu" />
        <Setter Property="AutomationProperties.Name" Value="Hiện mật khẩu" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="PART_bd" Background="{TemplateBinding Background}" CornerRadius="3">
                        <Grid Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3" StrokeLineJoin="Round"
                                  Data="M1,8 C3,4.2 5.4,2.8 8,2.8 C10.6,2.8 13,4.2 15,8 C13,11.8 10.6,13.2 8,13.2 C5.4,13.2 3,11.8 1,8 Z" />
                            <Ellipse Width="5" Height="5" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3" />
                            <Path x:Name="PART_slash" Visibility="Collapsed" Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M2.5,1.5 L13.5,14.5" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextBodyBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PART_slash" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="ToolTip" Value="Ẩn mật khẩu" />
                <Setter Property="AutomationProperties.Name" Value="Ẩn mật khẩu" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ComboBox: giữ template mặc định của WPF, chỉ đồng bộ chữ/cao với ô nhập (bản phẳng tự vẽ nằm ở theme gốc). -->
    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource ControlContentFontSize}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{StaticResource TextBodyBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{StaticResource TextBodyBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,16,0" />
    </Style>

    <!-- ══════════ THẺ · DANH SÁCH ══════════ -->
    <Style x:Key="card" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,14" />
    </Style>

    <Style x:Key="acctListItem" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BrandTintBrush}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrandTintBorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
