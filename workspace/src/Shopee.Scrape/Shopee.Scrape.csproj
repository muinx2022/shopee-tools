<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Shopee.Scrape</RootNamespace>
    <AssemblyName>ShopeeScrape</AssemblyName>
    <Version>1.0.0</Version>
    <StartupObject>Shopee.Scrape.Program</StartupObject>
    <ApplicationManifest>..\Shopee.Workspace\app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\app-icon.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\app-icon.ico" Link="Assets\app-icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shopee.Workspace\Shopee.Workspace.csproj" />
  </ItemGroup>

  <!-- 📦 Gói kèm extension shopee-scrape vào output khi build/publish 📦 -->
  <PropertyGroup>
    <RepoRoot>$(MSBuildProjectDirectory)\..\..</RepoRoot>
  </PropertyGroup>
  <ItemGroup>
    <ScrapeExtFiles Include="$(RepoRoot)\extensions\shopee-scrape\**\*" />
  </ItemGroup>
  <Target Name="BundleWorkspaceAssets" AfterTargets="Build">
    <Copy SourceFiles="@(ScrapeExtFiles)" DestinationFiles="@(ScrapeExtFiles->'$(OutDir)extensions\shopee-scrape\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="BundleWorkspaceAssetsPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(ScrapeExtFiles)" DestinationFiles="@(ScrapeExtFiles->'$(PublishDir)extensions\shopee-scrape\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
