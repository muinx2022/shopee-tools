{
  "manifest_version": 3,
  "name": "Shopee Harvest Runner",
  "version": "1.0.0",
  "description": "Mở link sản phẩm Shopee và lấy JSON chi tiết sản phẩm (get_pc) — điều khiển từ Shopee Harvest",
  "permissions": ["storage", "tabs", "scripting", "activeTab", "alarms", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://shopee.vn/*", "*://*.shopee.vn/*"],
      "js": ["pdp-store.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "ISOLATED"
    },
    {
      "matches": ["*://shopee.vn/*", "*://*.shopee.vn/*"],
      "js": ["pdp-hook.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
