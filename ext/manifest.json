{
  "manifest_version": 3,
  "name": "Shopee Automation Ext",
  "version": "1.2",
  "permissions": [
    "cookies",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "*://*.shopee.vn/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://shopee.vn/*", "*://*.shopee.vn/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
